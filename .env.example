# Banco Postgres (local ou Neon, com ?sslmode=require)
DATABASE_URL=postgresql://petmind:petmind123@localhost:5432/petmind

# Chave que assina os tokens de login. Em produção, use um valor longo e aleatório:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave
TOKEN_EXPIRACAO_HORAS=8

# IA (Groq): https://console.groq.com/keys
GROQ_API_KEY=sua_chave_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Origens extras do front liberadas no CORS (separadas por vírgula)
CORS_ALLOW_ORIGINS=

# Modo demonstração: cria contas de visitante e libera /auth/login-demo
DEMO_MODE=false

# Criar admin pela tela (só ambiente de teste)
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_KEY=
